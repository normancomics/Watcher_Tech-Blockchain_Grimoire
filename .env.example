# ─── Deployer ────────────────────────────────────────────────────────────────
# Private key of normancomics.eth deployer wallet (never commit a real key!)
PRIVATE_KEY=

# ─── Basescan / Etherscan ─────────────────────────────────────────────────────
BASESCAN_API_KEY=

# ─── RPC Endpoints ────────────────────────────────────────────────────────────
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# ─── x402 Payment Receiver ───────────────────────────────────────────────────
# normancomics.eth resolved address (for x402-express paymentMiddleware)
RECEIVER_WALLET=

# ─── R&D Treasury (Superfluid) ────────────────────────────────────────────────
# A dedicated, non-custodial wallet for the Watcher Tech Blockchain Grimoire
# R&D arm — separate from the author's personal RECEIVER_WALLET above. All
# incoming Superfluid CFA streams (enterGateSuperfluid) flow to this address,
# funding ongoing research & development (compute, gas, infra) independently
# of any personal or third-party treasury.
#
# Generate your own (never share or commit the private key):
#   foundry:  cast wallet new
#   ethers:   node -e "console.log(require('ethers').Wallet.createRandom().address)"
# Paste ONLY the resulting public address below.
RD_TREASURY_ADDRESS=

# ─── Deployed Contract Addresses (fill after running Deploy.s.sol) ────────────
SIGIL_NFT_ADDRESS=
ARCANUS_MATHEMATICA_ADDRESS=
SPELL_PAYMENT_ADDRESS=
WATCHER_GATE_ADDRESS=
ERC8004_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
